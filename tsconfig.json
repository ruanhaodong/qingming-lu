{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "phaser"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "pixelfx": [
        "vendor/pixelfx/src/core/index.js"
      ],
      "pixelfx/fx/*": [
        "vendor/pixelfx/src/fx/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
